<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Learn This App</title>
  </head>
  <body>
    <outline text="Learn This App" color="#e6edf3">
      <outline text="1. Load a tree" color="#ff6ac1">
        <outline text="Run with a path: ./app mytree.opml" color="#ff6ac1"></outline>
        <outline text="No path given: starts empty with one root" color="#ff6ac1"></outline>
      </outline>
      <outline text="2. Navigate" color="#4ea8de">
        <outline text="Left / h: move left" color="#4ea8de"></outline>
        <outline text="Right / l: move right" color="#4ea8de"></outline>
        <outline text="Up / k: move up" color="#4ea8de"></outline>
        <outline text="Down / j: move down" color="#4ea8de"></outline>
        <outline text="Selection follows spatial layout, not tree order" color="#4ea8de"></outline>
      </outline>
      <outline text="3. Edit" color="#ffb454">
        <outline text="i / a: enter edit mode on selected box" color="#ffb454"></outline>
        <outline text="Type to replace text" color="#ffb454"></outline>
        <outline text="Esc: commit and exit edit mode" color="#ffb454"></outline>
      </outline>
      <outline text="4. Build out the tree" color="#7ee787">
        <outline text="o / enter: add sibling" color="#7ee787"></outline>
        <outline text="O / tab: add child" color="#7ee787"></outline>
        <outline text="Empty node + Esc: removes it" color="#7ee787"></outline>
      </outline>
      <outline text="5. Reorder" color="#b399ff">
        <outline text="K: move node up among siblings" color="#b399ff"></outline>
        <outline text="J: move node down among siblings" color="#b399ff"></outline>
      </outline>
      <outline text="6. Save" color="#ff6ac1">
        <outline text="ctrl+s: write tree back to the OPML path" color="#ff6ac1"></outline>
        <outline text="Status line confirms save or shows the error" color="#ff6ac1"></outline>
      </outline>
      <outline text="Other" color="#4ea8de">
        <outline text="?: toggle help view" color="#4ea8de"></outline>
        <outline text="q / esc / ctrl+c: quit" color="#4ea8de"></outline>
      </outline>
    </outline>
  </body>
</opml>
